{
  "version": "2.1.0",
  "strapi": {
    "kind": "plugin",
    "name": "generic-custom-fields",
    "displayName": "Generic Custom Fields",
    "description": "This plugin allows you to easily add custom fields to Strapi."
  },
  "name": "strapi-plugin-generic-custom-fields",
  "description": "This plugin allows you to easily add custom fields to Strapi.",
  "keywords": [
    "strapi",
    "plugin",
    "custom-fields",
    "generic-custom-fields"
  ],
  "author": {
    "name": "Christophe Carvalho Vilas-Boas",
    "url": "https://github.com/ChristopheCVB"
  },
  "maintainers": [
    {
      "name": "Christophe Carvalho Vilas-Boas",
      "url": "https://github.com/ChristopheCVB"
    }
  ],
  "contributors": [
    {
      "name": "Christophe Carvalho Vilas-Boas",
      "url": "https://github.com/ChristopheCVB"
    },
    {
      "name": "Vivian Grimaux",
      "url": "https://github.com/wezerg"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopheCVB/strapi-plugin-generic-custom-fields.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "typecheck:admin": "tsc --noEmit -p admin/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@strapi/design-system": "2.2.4",
    "@strapi/icons": "2.2.4",
    "@uidotdev/usehooks": "^2.4.1",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.0",
    "@strapi/typescript-utils": "^5.61.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/koa": "2.15.2",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "6.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@12.18.0"
}
