{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "config/**/*.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "types/**/*.d.ts",
    "vitest.smoke.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
